package.json
package-lock.json

# 2. Tailwind Build & Source Configs
tailwind.config
tailwind.config.js
input.css
assets/css/input.css

# 3. Supabase Secret Keys & Environment Data
.env
.env.local
.env.*.local

# 4. Logs & Notes (තාවකාලික සටහන්)
*.log
changes.txt

# 5. OS Generated Files (මෙහෙයුම් පද්ධති තාවකාලික ගොනු)
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# 6. Code Editor Settings (VS Code)
.vscode/*
!.vscode/settings.json
.idea/
